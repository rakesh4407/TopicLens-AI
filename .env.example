# TopicLens AI Environment Variables
# Copy this file to .env and customize values if needed.
# Most settings use sensible defaults from src/config.py.

# Optional: Override NLTK data path
NLTK_DATA_PATH=

# Optional: Override model save directory (relative to project root)
MODEL_SAVE_DIR=models/

# Optional: Override output directory (relative to project root)
OUTPUT_DIR=outputs/
